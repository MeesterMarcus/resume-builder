{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "resume-builder",
  "main": "./worker/index.js",
  "compatibility_date": "2026-07-29",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/site",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "AI_ALLOWED_IPS": "136.50.177.197"
  }
}
